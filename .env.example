# Direct path to a locally built Litex executable.
LITEX_BIN=/absolute/path/to/litex
LITEXPY_LITEX_BIN=/absolute/path/to/litex

# Or let litexpy launch the pinned source checkout through Cargo.
# LITEXPY_LITEX_COMMAND=cargo run --quiet --manifest-path /absolute/path/to/golitex/Cargo.toml --

LITEX_CHESS_TIMEOUT=30
LITEX_CHESS_INCLUDE_SOURCE=1
